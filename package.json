{
  "name": "anycommit",
  "displayName": "AnyCommit: AI Commit Message",
  "icon": "media/icon.png",
  "description": "Generate clean git commit messages from staged diff using OpenAI-compatible APIs, including local gateways (9router, OmniRoute, Ollama, LM Studio) and custom model providers.",
  "version": "0.1.2",
  "publisher": "makdumibrohim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MakdumIbrohim/anycommit-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCommit.generate",
        "title": "AI Commit: Generate Commit Message",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "aiCommit.regenerate",
        "title": "AI Commit: Regenerate Commit Message",
        "icon": "$(refresh)"
      },
      {
        "command": "aiCommit.setApiKey",
        "title": "AI Commit: Set API Key"
      },
      {
        "command": "aiCommit.clearApiKey",
        "title": "AI Commit: Clear API Key"
      },
      {
        "command": "aiCommit.selectModel",
        "title": "AI Commit: Select Model"
      },
      {
        "command": "aiCommit.selectProvider",
        "title": "AI Commit: Select Provider"
      },
      {
        "command": "aiCommit.showQuickMenu",
        "title": "AI Commit: Show Quick Menu"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommit.generate",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "aiCommit.regenerate",
          "when": "scmProvider == git",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "AnyCommit",
      "properties": {
        "aiCommit.provider": {
          "type": "string",
          "default": "9router",
          "description": "Active AI provider ID (built-in preset like 9router, omniroute, openai, openrouter, groq, deepseek, custom, or any custom provider ID from aiCommit.customProviders)."
        },
        "aiCommit.customProviders": {
          "type": "array",
          "default": [],
          "description": "List of custom OpenAI-compatible model providers (e.g. Ollama, LM Studio, vLLM, or private gateways).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique provider identifier (e.g. 'ollama', 'lmstudio')."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in UI."
              },
              "baseUrl": {
                "type": "string",
                "description": "OpenAI-compatible base URL (e.g. 'http://localhost:11434/v1')."
              }
            }
          }
        },
        "aiCommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL override (e.g. http://localhost:20128/v1). Required for custom provider."
        },
        "aiCommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the active provider. (Optional: If empty, uses secure SecretStorage)."
        },
        "aiCommit.model": {
          "type": "string",
          "default": "",
          "description": "Model or combo name (e.g. cc/claude-opus-4-6, premium-coding, auto/best-coding)."
        },
        "aiCommit.language": {
          "type": "string",
          "default": "English",
          "description": "Language used for generated commit messages (e.g. English, Indonesian)."
        },
        "aiCommit.style": {
          "type": "string",
          "default": "conventional",
          "enum": [
            "conventional",
            "gitmoji",
            "plain"
          ],
          "enumDescriptions": [
            "Conventional Commits (e.g. feat(auth): add login)",
            "Gitmoji style (e.g. :sparkles: add login)",
            "Plain imperative sentence (e.g. Add user login flow)"
          ],
          "description": "Format style of the generated commit message."
        },
        "aiCommit.includeBody": {
          "type": "boolean",
          "default": false,
          "description": "Include detailed bullet points in the commit message body."
        },
        "aiCommit.useRecentCommits": {
          "type": "boolean",
          "default": true,
          "description": "Include recent repository commits in the prompt as style and tone examples."
        },
        "aiCommit.autoDetectScope": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect commit scope from modified folder/file paths for Conventional Commits."
        },
        "aiCommit.extractTicketFromBranch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically extract issue/ticket ID from the current git branch name and include it in the commit message."
        },
        "aiCommit.ticketPattern": {
          "type": "string",
          "default": "[A-Z]+-[0-9]+",
          "description": "Regular expression pattern used to extract issue/ticket ID from branch name (e.g. [A-Z]+-[0-9]+ for JIRA/Linear, or (?:issue|gh)-[0-9]+)."
        },
        "aiCommit.extraInstructions": {
          "type": "string",
          "default": "",
          "description": "Additional custom instructions for commit message prompt (e.g. include ticket ID from branch name)."
        },
        "aiCommit.maxDiffChars": {
          "type": "integer",
          "default": 20000,
          "description": "Maximum number of git diff characters sent to LLM."
        },
        "aiCommit.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Model sampling temperature (0 to 2)."
        },
        "aiCommit.maxTokens": {
          "type": "integer",
          "default": 1000,
          "description": "Maximum completion tokens returned by LLM. Set to 1000+ for reasoning models."
        },
        "aiCommit.timeoutSeconds": {
          "type": "integer",
          "default": 60,
          "description": "Request timeout in seconds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "format": "prettier --write .",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
